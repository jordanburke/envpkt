{
  "name": "envpkt",
  "version": "0.19.0",
  "description": "Credential lifecycle and fleet management for AI agents",
  "keywords": [
    "credentials",
    "secrets",
    "ai-agents",
    "mcp",
    "toml",
    "fleet-management"
  ],
  "author": "jordan.burke@gmail.com",
  "license": "Apache-2.0",
  "homepage": "https://github.com/jordanburke/envpkt",
  "repository": {
    "type": "git",
    "url": "https://github.com/jordanburke/envpkt"
  },
  "bin": {
    "envpkt": "dist/cli.js"
  },
  "scripts": {
    "validate": "ts-builds validate",
    "ci": "ts-builds ci",
    "format": "ts-builds format",
    "format:check": "ts-builds format:check",
    "lint": "ts-builds lint",
    "lint:check": "ts-builds lint:check",
    "typecheck": "ts-builds typecheck",
    "test": "ts-builds test",
    "test:watch": "ts-builds test:watch",
    "test:coverage": "ts-builds test:coverage",
    "build": "ts-builds build",
    "build:schema": "tsx scripts/build-schema.ts",
    "demo": "tsx scripts/generate-demo-html.ts",
    "dev": "ts-builds dev",
    "docs:dev": "pnpm --dir site dev",
    "docs:build": "pnpm --dir site build",
    "prepublishOnly": "pnpm run ci"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "age-encryption": "^0.3.1",
    "commander": "^15.1.0",
    "functype": "^2.2.0",
    "functype-log": "^2.2.0",
    "functype-os": "^2.2.0",
    "smol-toml": "^1.9.1",
    "somamcp": "^2.11.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "~2.4.0",
    "@types/node": "^24.19.2",
    "ts-builds": "^5.0.0",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": "./schemas/envpkt.schema.json"
  },
  "files": [
    "lib",
    "dist",
    "schemas"
  ],
  "prettier": "ts-builds/prettier",
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975"
}
